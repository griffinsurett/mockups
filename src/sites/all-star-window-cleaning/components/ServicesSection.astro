---
const services = [
  {
    img: "/all-star-window-cleaning/commercial.webp",
    title: "Window Cleaning",
    body: "Interior and exterior window cleaning for homes and businesses. Streak-free results, every time.",
  },
  {
    img: "/all-star-window-cleaning/wash-equipment_files/unnamed(11).webp",
    title: "Power Washing",
    body: "Driveways, siding, decks, and fences blasted clean with professional-grade equipment.",
  },
  {
    img: "/all-star-window-cleaning/wash-equipment_files/unnamed(12).webp",
    title: "Gutter Cleaning",
    body: "We clear out debris and buildup so your gutters flow freely and protect your property.",
  },
  {
    img: "/all-star-window-cleaning/window_files/unnamed(3).jpg",
    title: "Junk Removal",
    body: "Fast, affordable junk removal for homes and businesses — we haul it, you forget it.",
  },
];
---

<section aria-label="Our services" class="w-full grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 bg-black">
  {services.map(service => (
    <a href="/all-star-window-cleaning/contact" class="group relative h-[350px] lg:h-[400px] overflow-hidden flex flex-col justify-end border-r border-white/10 last:border-r-0 focus-visible:outline-2 focus-visible:outline-offset-[-4px] focus-visible:outline-[#dcfb19]">
      <img src={service.img} alt={service.title} loading="lazy" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
      <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(0,0,0,0.92), rgba(0,0,0,0.25));" aria-hidden="true"></div>
      <div class="relative z-10 p-6 lg:p-8">
        <h2 class="text-xl xl:text-2xl font-black uppercase tracking-tight text-white mb-3">{service.title}</h2>
        <p class="text-white/80 text-sm leading-relaxed">{service.body}</p>
        <span class="inline-block mt-5 text-xs font-bold uppercase tracking-widest text-[#dcfb19]">Get a Free Estimate →</span>
      </div>
    </a>
  ))}
</section>
