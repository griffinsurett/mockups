---
import BeforeAfterSlider from './BeforeAfterSlider';

const projects = ["paint", "interior", "wheel"].map(name => ({ before: `/sites/lor-noir-mobile-detailing/images/${name}-before.webp`, after: `/sites/lor-noir-mobile-detailing/images/${name}-after.webp`, label: name === "paint" ? "Exterior finish" : name === "interior" ? "Interior care" : "Wheel detailing" }));
---

<section class="w-full bg-black py-20 px-6 md:px-16 border-t border-white/10">
  <div class="max-w-7xl mx-auto">

    <!-- Header -->
    <div class="text-center mb-14">
      <p class="text-xs font-bold tracking-[0.3em] uppercase mb-3 bg-linear-to-r from-[#bca477] to-[#e4d5b5] bg-clip-text text-transparent" style="font-family: 'Inter', sans-serif;">
        SEE THE DIFFERENCE
      </p>
      <h2 class="text-3xl md:text-5xl font-bold text-white leading-tight" style="font-family: 'Playfair Display', serif;">
        Before &amp; After
      </h2>
      <div class="w-12 h-0.5 mx-auto mt-6" style="background: linear-gradient(to right, #bca477, #e4d5b5);"></div>
      <p class="text-white/40 text-sm mt-4 max-w-md mx-auto" style="font-family: 'Inter', sans-serif;">
        Drag the slider to see the difference.
      </p>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {projects.map((p) => (
        <BeforeAfterSlider
          client:visible
          label={p.label}
          before={p.before}
          after={p.after}
          className="border border-white/10"
        />
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center mt-12">
      <a href="/lor-noir-mobile-detailing/contact" class="inline-block border-2 border-white text-white font-bold text-sm tracking-widest py-3 px-8 hover:bg-white hover:text-black transition-colors duration-300 uppercase rounded-sm bg-black/20" style="font-family: 'Inter', sans-serif;">
        BOOK YOUR TRANSFORMATION
      </a>
    </div>

  </div>
</section>
