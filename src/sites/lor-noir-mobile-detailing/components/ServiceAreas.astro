---
import { serviceAreas } from "../data/serviceAreas";
---

<section
  class="w-full bg-cover bg-center lg:bg-fixed relative border-b-[6px] border-[#bca477]"
  style="background-image: url('/sites/lor-noir-mobile-detailing/images/gallery-2.webp')"
>
  <div class="absolute inset-0 bg-black/90"></div>

  <div class="relative z-10 flex flex-col md:flex-row min-h-135">

    <!-- Map -->
    <div class="w-full md:w-1/3 min-h-[360px] md:min-h-0">
      <iframe
        title="L’Or Noir Mobile Detailing — Service Area"
        src="https://maps.google.com/maps?q=Miami+Florida&output=embed&z=10"
        width="100%"
        height="100%"
        style="border:0; display:block; min-height:360px; filter: grayscale(1) invert(1) contrast(0.85);"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>

    <!-- Areas list -->
    <div class="w-full md:w-2/3 py-12 px-8 lg:px-14 flex flex-col justify-center border-l border-white/10">

      <p class="text-xs font-bold tracking-[0.3em] uppercase mb-3 bg-linear-to-r from-[#bca477] to-[#e4d5b5] bg-clip-text text-transparent" style="font-family: 'Inter', sans-serif;">
        WE COME TO YOU
      </p>

      <h2 class="text-3xl md:text-4xl font-bold text-white mb-2 leading-tight" style="font-family: 'Playfair Display', serif;">
        Serving Miami and the Surrounding Areas
      </h2>

      <div class="w-12 h-[2px] bg-linear-to-r from-[#bca477] to-[#e4d5b5] mb-8"></div>

      <ul class="grid grid-cols-2 md:grid-cols-3 gap-x-6 gap-y-3">
        {serviceAreas.map(area => (
          <li class="flex items-center gap-2 text-sm font-semibold text-white/80">
            <span class="w-1.5 h-1.5 rounded-full bg-[#bca477] shrink-0"></span>
            {area}
          </li>
        ))}
      </ul>


      <p class="mt-8 text-xs text-white/40 font-medium" style="font-family: 'Inter', sans-serif;">
        Near the edge of our service area? <a href="/lor-noir-mobile-detailing/contact" class="text-[#bca477] hover:text-[#e4d5b5] transition-colors underline">Contact us</a> to confirm your address.
      </p>

    </div>

  </div>

</section>
