<section class="w-full bg-[#050508] grid grid-cols-1 lg:grid-cols-2 border-t border-gray-950 overflow-hidden relative">

  <div class="relative z-20 flex items-center bg-[#050508] py-20 px-8 sm:py-24 sm:px-16 lg:py-32 lg:pl-24 lg:pr-16">
    <div class="max-w-xl">
      <span class="text-xs font-black tracking-[0.3em] text-[#bca477] uppercase mb-4 block" style="font-family: 'Inter', sans-serif;">BUILT FOR CAR LOVERS</span>
      <h2 class="text-3xl md:text-[38px] text-white font-bold leading-tight mb-6 drop-shadow-xl" style="font-family: 'Playfair Display', serif;">
        Bring your vehicle back to the condition it deserves.
      </h2>
      <div class="w-12 h-1 bg-[#bca477] mb-8 shadow-[0_0_10px_rgba(188,164,119,0.5)]"></div>
      <p class="text-lg md:text-xl italic mb-10 leading-relaxed bg-linear-to-r from-[#bca477] to-[#e4d5b5] bg-clip-text text-transparent" style="font-family: 'Playfair Display', serif;">
        "Every Car Has a Story — We Make It Look the Part."
      </p>
      <div class="space-y-6 mb-12">
        <div class="flex items-start gap-4">
          <svg class="w-6 h-6 shrink-0 text-[#bca477]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <circle cx="12" cy="12" r="5" />
            <circle cx="12" cy="12" r="1" fill="currentColor" stroke="none" />
          </svg>
          <div>
            <h4 class="text-sm font-black text-white uppercase tracking-wider" style="font-family: 'Inter', sans-serif;">DETAIL-FIRST APPROACH</h4>
            <p class="text-xs text-gray-400 mt-1 leading-relaxed" style="font-family: 'Inter', sans-serif;">No corner skipped — every seam, vent, and surface gets the same thorough treatment.</p>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <i class="ph-fill ph-shield-check text-2xl text-[#bca477]"></i>
          <div>
            <h4 class="text-sm font-black text-white uppercase tracking-wider" style="font-family: 'Inter', sans-serif;">QUALITY YOU CAN SEE</h4>
            <p class="text-xs text-gray-400 mt-1 leading-relaxed" style="font-family: 'Inter', sans-serif;">From flawless paint to a spotless cabin — the results speak louder than any promise.</p>
          </div>
        </div>
      </div>
      <a href="/lor-noir-mobile-detailing/contact#inquiry" class="inline-block bg-linear-to-r from-[#bca477] to-[#e4d5b5] text-black font-bold text-xs tracking-widest py-4 px-10 rounded-sm hover:bg-[#e4d5b5] hover:text-black transition-colors uppercase shadow-lg shadow-[#bca477]/30" style="font-family: 'Inter', sans-serif;">
        EXPLORE THE PACKAGES
      </a>
    </div>
  </div>

  <div class="w-full h-80 sm:h-112.5 lg:h-auto min-h-full relative overflow-hidden -mt-0.5 lg:mt-0 lg:-ml-0.5 z-10 bg-[#cfdbe8] flex items-center justify-center">
    <img src="/sites/lor-noir-mobile-detailing/images/gallery-1.webp" alt="Polished black sports coupe" class="w-full h-full object-cover object-center lg:absolute lg:inset-0 scale-105 transition-transform duration-700" />
    <div class="absolute inset-0 bg-linear-to-b from-[#050508] via-transparent to-transparent lg:bg-linear-to-r lg:from-[#050508] lg:via-[#050508]/15 lg:via-12% lg:to-transparent lg:to-30% pointer-events-none z-10"></div>
  </div>

</section>
