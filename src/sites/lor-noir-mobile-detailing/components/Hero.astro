---
import Logo from './Logo.astro';
import PhoneLink from './PhoneLink';
---
<section class="relative w-full min-h-[760px] md:min-h-[820px] flex items-center justify-center text-center">
  <div
    class="absolute inset-0 z-0 bg-cover bg-center lg:bg-fixed"
    style="background-image: url('/sites/lor-noir-mobile-detailing/images/gallery-1.webp')"
    role="img"
    aria-label="Black sports coupe outside a Miami residence"
  >
    <div class="absolute inset-0 bg-black/80"></div>
  </div>

  <div class="relative z-10 flex flex-col items-center px-4 pt-36 pb-16">
    <div>
      <Logo class="w-80 md:w-[560px] max-w-full mb-8" />
    </div>

    <h1 class="text-3xl md:text-5xl text-white font-bold max-w-4xl leading-tight mb-6 drop-shadow-xl" style="text-shadow: 2px 2px 4px rgba(0,0,0,0.5); font-family: 'Playfair Display', serif;">
      EXCEPTIONAL CARE.<br />RIGHT IN YOUR DRIVEWAY.
    </h1>

    <p class="text-white text-lg md:text-xl font-bold tracking-[0.2em] uppercase mb-10 drop-shadow-md" style="font-family: 'Inter', sans-serif;">
      LUXURY MOBILE DETAILING IN MIAMI
    </p>

    <div class="flex flex-col sm:flex-row items-center gap-4">
      <a href="/lor-noir-mobile-detailing/contact" class="border-2 border-white text-white font-bold text-sm tracking-widest py-3 px-8 hover:bg-white hover:text-black transition-colors duration-300 uppercase rounded-sm bg-black/20" style="font-family: 'Inter', sans-serif;">
        EXPLORE OUR SERVICES
      </a>
      <PhoneLink client:load />
    </div>
  </div>
</section>
