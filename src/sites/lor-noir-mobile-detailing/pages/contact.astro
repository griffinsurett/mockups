---
import { serviceAreas } from "../data/serviceAreas";
import Layout from "../Layout.astro";
import TopBar from "../components/TopBar.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Logo from "../components/Logo.astro";
import PageHero from "../components/PageHero.astro";
import GallerySection from "../components/GallerySection.astro";
---

<Layout title="Contact — L’Or Noir Mobile Detailing">
  <TopBar />
  <Header />
  <PageHero title="Book Your Detail" subtitle="Serving Miami and the Surrounding Areas" breadcrumb="Contact Us" />

  <main class="w-full bg-black text-white min-h-screen flex flex-col lg:flex-row">

    <!-- Left: info panel -->
    <div class="w-full lg:w-1/2 flex flex-col justify-center px-8 lg:px-16 xl:px-24 py-20 bg-[#050811] border-b lg:border-b-0 lg:border-r border-gray-900">

      <Logo class="w-48 mb-10" />

      <span class="text-xs font-black tracking-[0.3em] text-[#bca477] uppercase mb-3 block" style="font-family: 'Inter', sans-serif;">GET IN TOUCH</span>
      <h1 class="text-4xl md:text-5xl font-bold leading-tight text-white mb-4 uppercase" style="font-family: 'Playfair Display', serif;">
        Book Your Detail
      </h1>
      <div class="w-12 h-1 bg-gradient-to-r from-[#bca477] to-[#e4d5b5] mb-8"></div>
      <p class="text-white/60 text-sm leading-relaxed mb-12 max-w-sm" style="font-family: 'Inter', sans-serif;">
        Tell us about your vehicle and the care it needs. Mobile detailing at your home or office in Miami and the surrounding areas.
      </p>

      <div class="flex flex-col gap-7">
        <div>
          <p class="text-[0.7rem] uppercase tracking-[0.08em] text-white/40 mb-1" style="font-family: 'Inter', sans-serif;">Service style</p>
          <a href="/lor-noir-mobile-detailing/contact#inquiry" class="text-2xl font-extrabold text-white tracking-tight hover:text-[#bca477] transition-colors" style="font-family: 'Inter', sans-serif;">At your home or office</a>
        </div>
        <div>
          <p class="text-[0.7rem] uppercase tracking-[0.08em] text-white/40 mb-1" style="font-family: 'Inter', sans-serif;">Service Area</p>
          <p class="text-white font-semibold" style="font-family: 'Inter', sans-serif;">Miami, Florida — Mobile Service</p>
          <p class="text-white/60 text-xs mt-4 leading-relaxed">{serviceAreas.join(" · ")}</p></p>)}
        </div>
        <div>
          <p class="text-[0.7rem] uppercase tracking-[0.08em] text-white/40 mb-1" style="font-family: 'Inter', sans-serif;">Hours</p>
          <p class="text-white font-semibold" style="font-family: 'Inter', sans-serif;">Mon – Sat: 8am – 6pm</p>
        </div>
      </div>
    </div>

    <!-- Right: form -->
    <div class="w-full lg:w-1/2 flex flex-col justify-center px-8 lg:px-16 xl:px-24 py-20 bg-black">
      <h2 class="text-2xl font-bold text-white uppercase mb-8" style="font-family: 'Playfair Display', serif;">Request a Quote</h2>

      <form id="inquiry" class="flex flex-col gap-5" name="demo-inquiry">
        <!-- Name + Phone -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div class="flex flex-col gap-1">
            <label for="inquiry-1" class="text-[0.7rem] uppercase tracking-[0.08em] text-white/50" style="font-family: 'Inter', sans-serif;">Full Name</label>
            <input id="inquiry-1"
              type="text"
              name="name"
              placeholder="John Smith"
              required
              class="bg-[#0d0d0d] border border-white/10 text-white placeholder-white/25 px-4 py-3 text-sm focus:outline-none focus:border-[#bca477] transition-colors"
              style="font-family: 'Inter', sans-serif;"
            />
          </div>
          <div class="flex flex-col gap-1">
            <label for="inquiry-2" class="text-[0.7rem] uppercase tracking-[0.08em] text-white/50" style="font-family: 'Inter', sans-serif;">Phone Number</label>
            <input id="inquiry-2"
              type="tel"
              name="phone"
              placeholder="(305) 555-0100"
              required
              class="bg-[#0d0d0d] border border-white/10 text-white placeholder-white/25 px-4 py-3 text-sm focus:outline-none focus:border-[#bca477] transition-colors"
              style="font-family: 'Inter', sans-serif;"
            />
          </div>
        </div>

        <!-- Email -->
        <div class="flex flex-col gap-1">
          <label for="inquiry-3" class="text-[0.7rem] uppercase tracking-[0.08em] text-white/50" style="font-family: 'Inter', sans-serif;">Email Address</label>
          <input id="inquiry-3"
            type="email"
            name="email"
            placeholder="john@email.com"
            class="bg-[#0d0d0d] border border-white/10 text-white placeholder-white/25 px-4 py-3 text-sm focus:outline-none focus:border-[#bca477] transition-colors"
            style="font-family: 'Inter', sans-serif;"
          />
        </div>

        <!-- Vehicle Type -->
        <div class="flex flex-col gap-1">
          <label for="inquiry-4" class="text-[0.7rem] uppercase tracking-[0.08em] text-white/50" style="font-family: 'Inter', sans-serif;">Vehicle Type</label>
          <select id="inquiry-4"
            name="vehicle_type"
            required
            class="bg-[#0d0d0d] border border-white/10 text-white px-4 py-3 text-sm focus:outline-none focus:border-[#bca477] transition-colors appearance-none"
            style="font-family: 'Inter', sans-serif;"
          >
            <option value="" disabled selected>Select your vehicle...</option>
            <option>Sedan / Coupe</option>
            <option>SUV / Crossover</option>
            <option>Truck</option>
            <option>Van / Minivan</option>
            <option>Luxury / Exotic</option>
            <option>Other</option>
          </select>
        </div>

        <!-- Service -->
        <div class="flex flex-col gap-1">
          <label for="inquiry-5" class="text-[0.7rem] uppercase tracking-[0.08em] text-white/50" style="font-family: 'Inter', sans-serif;">Service Needed</label>
          <select id="inquiry-5"
            name="service"
            required
            class="bg-[#0d0d0d] border border-white/10 text-white px-4 py-3 text-sm focus:outline-none focus:border-[#bca477] transition-colors appearance-none"
            style="font-family: 'Inter', sans-serif;"
          >
            <option value="" disabled selected>Select a service...</option>
            <option>Full Detail (Interior + Exterior)</option>
            <option>Interior Detail Only</option>
            <option>Exterior Detail Only</option>
            <option>Ceramic Coating</option>
            <option>Fleet Cleaning</option>
            <option>Add-On Only</option>
            <option>Other / Not Sure</option>
          </select>
        </div>

        <!-- Location -->
        <div class="flex flex-col gap-1">
          <label for="inquiry-6" class="text-[0.7rem] uppercase tracking-[0.08em] text-white/50" style="font-family: 'Inter', sans-serif;">Service Location (City)</label>
          <input id="inquiry-6"
            type="text"
            name="location"
            placeholder="e.g. Miami, Coral Gables..."
            class="bg-[#0d0d0d] border border-white/10 text-white placeholder-white/25 px-4 py-3 text-sm focus:outline-none focus:border-[#bca477] transition-colors"
            style="font-family: 'Inter', sans-serif;"
          />
        </div>

        <!-- Message -->
        <div class="flex flex-col gap-1">
          <label for="inquiry-7" class="text-[0.7rem] uppercase tracking-[0.08em] text-white/50" style="font-family: 'Inter', sans-serif;">Additional Notes</label>
          <textarea id="inquiry-7"
            name="message"
            rows="4"
            placeholder="Tell us about your vehicle's condition, any add-ons you're interested in, or preferred date..."
            class="bg-[#0d0d0d] border border-white/10 text-white placeholder-white/25 px-4 py-3 text-sm focus:outline-none focus:border-[#bca477] transition-colors resize-none"
            style="font-family: 'Inter', sans-serif;"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full bg-gradient-to-r from-[#bca477] to-[#e4d5b5] text-black font-extrabold text-xs uppercase tracking-widest py-4 hover:opacity-90 transition-opacity shadow-lg shadow-[#bca477]/20 mt-2"
          style="font-family: 'Inter', sans-serif;"
        >
          Review Request
        </button>
      <p id="inquiry-status" role="status" class="text-sm text-[#e4d5b5]" hidden></p>
      </form>
    </div>

  </main>

  <GallerySection />
  <Footer />
</Layout>

<script>
  document.getElementById('inquiry')?.addEventListener('submit', (event) => {
    event.preventDefault();
    const status = document.getElementById('inquiry-status');
    if (status) { status.hidden = false; status.textContent = 'Your selections are ready to review.'; }
  });
</script>
