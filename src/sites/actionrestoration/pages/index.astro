      <script is:inline>
        (function() {
          var reviews = [
            { text: '"They treated our flooded first floor as a true emergency and gave us an actionable plan immediately. Communication stayed clear from start to finish — I always knew what was happening."', name: 'James R.', role: 'Homeowner, Howell', initial: 'J' },
            { text: '"Communication stayed structured from mitigation through restoration, which made tenant coordination significantly easier during an already stressful situation."', name: 'Maria T.', role: 'Property Manager, Monmouth County', initial: 'M' },
            { text: '"Strong containment and restoration sequencing after a smoke event in our commercial space. The team handled everything professionally with minimal disruption to operations."', name: 'David K.', role: 'Business Owner, Freehold', initial: 'D' },
            { text: '"Responded within the hour after our basement flooded. The crew was professional, explained every step clearly, and the drying process was faster than I expected. Highly recommend."', name: 'Sandra L.', role: 'Homeowner, Brick, NJ', initial: 'S' }
          ];
          var current = 0;
          var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          var timer;
          function render(direction) {
            var r = reviews[current];
            document.getElementById('reviewsText').textContent = r.text;
            document.getElementById('reviewsName').textContent = r.name;
            document.getElementById('reviewsRole').textContent = r.role;
            document.getElementById('reviewsAvatar').textContent = r.initial;
            document.getElementById('reviewsTextMobile').textContent = r.text;
            document.getElementById('reviewsNameMobile').textContent = r.name;
            document.getElementById('reviewsRoleMobile').textContent = r.role;
            document.getElementById('reviewsAvatarMobile').textContent = r.initial;
            if (direction && !reducedMotion) {
              [document.getElementById('reviewsCard'), document.getElementById('reviewsCardMobile')].forEach(function(card) {
                card.animate([
                  { opacity: 0.35, transform: 'translateX(' + (direction * 18) + 'px)' },
                  { opacity: 1, transform: 'translateX(0)' }
                ], { duration: 340, easing: 'ease-out' });
              });
            }
          }
          function restart() {
            window.clearInterval(timer);
            if (!reducedMotion) timer = window.setInterval(next, 6000);
          }
          function prev() { current = (current - 1 + reviews.length) % reviews.length; render(-1); restart(); }
          function next() { current = (current + 1) % reviews.length; render(1); }
          document.getElementById('reviewsPrev').addEventListener('click', prev);
          document.getElementById('reviewsNext').addEventListener('click', next);
          document.getElementById('reviewsPrevMobile').addEventListener('click', prev);
          document.getElementById('reviewsNextMobile').addEventListener('click', next);
          render(0);
          restart();
        })();
      </script>

