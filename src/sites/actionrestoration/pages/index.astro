---
import Layout from "../Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---
<Layout title="Reactive Restoration Services | 24/7 Emergency Property Damage Restoration" description="Reactive Restoration Services provides 24/7 emergency property damage restoration for residential and commercial properties in Howell, Monmouth County, and surrounding New Jersey communities." data-page="home" class="min-h-screen font-body leading-[1.55] text-slate-ar-900 [text-rendering:optimizeLegibility]"
  style="background: radial-gradient(circle at 90% 0%, rgba(46,110,173,0.1) 0%, rgba(46,110,173,0) 42%), linear-gradient(180deg,#f7fafe 0%,#f2f7fc 45%,#eff4fa 100%);">

  <Header active="/actionrestoration" />
  <div>
    <main class="min-w-0">

      <!-- Hero -->
      <section class="hero-carousel relative flex flex-col justify-center items-stretch min-h-[70vh] px-[clamp(24px,5vw,80px)] py-[clamp(48px,6vw,80px)] text-white" aria-roledescription="carousel" aria-label="Reactive Restoration emergency services">
        <div class="hero-slides" aria-hidden="true">
          <div class="hero-slide is-active" style="background-image:url('/sites/actionrestoration/assets/hero-water-restoration.webp')"></div>
          <div class="hero-slide" style="background-image:url('/sites/actionrestoration/assets/hero-fire-restoration.webp')"></div>
          <div class="hero-slide" style="background-image:url('/sites/actionrestoration/assets/hero-storm-monmouth.webp')"></div>
        </div>
        <div class="hero-shade" aria-hidden="true"></div>
        <div class="hero-content w-full max-w-site mx-auto">
          <span class="inline-flex mb-[9px] items-center gap-2 text-[0.75rem] font-sora uppercase tracking-[0.08em] font-bold" style="color:#d2e8ff;">
            <img src="/sites/actionrestoration/assets/water-and-fire.png" alt="" aria-hidden="true" class="w-5 h-5 object-contain" />
            Emergency Property Damage Restoration
          </span>
          <h1 class="font-sora leading-[1.16] tracking-[-0.01em] text-white text-[clamp(2rem,4.2vw,3.3rem)] mb-3">Emergency Response in Monmouth County for Water, Fire, and Mold Damage</h1>
          <p class="text-[1.08rem] text-white/90">
            Reactive Restoration Services helps homeowners, property managers, and businesses stabilize damage fast.
            We focus on urgent mitigation first, then complete restoration to support pre-loss condition recovery.
          </p>
          <div class="hero-actions-row mt-[22px] flex flex-wrap items-center gap-[10px]">
            <a class="rounded-full inline-flex items-center justify-center gap-1.5 px-4 py-2.5 font-sora text-[0.84rem] font-bold tracking-[0.01em] cursor-pointer transition-all duration-200 hover:-translate-y-px bg-orange-500 text-white shadow-[0_10px_18px_rgba(217,91,23,0.28)] hover:bg-orange-600" href="/actionrestoration/contact#emergency">Request Emergency Help</a>
            <div class="hero-rating">
              <svg width="26" height="26" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path fill="#4285F4" d="M44.5 20H24v8.5h11.8C34.7 33.9 30.1 37 24 37c-7.2 0-13-5.8-13-13s5.8-13 13-13c3.1 0 5.9 1.1 8.1 2.9l6.4-6.4C34.6 5.1 29.6 3 24 3 12.4 3 3 12.4 3 24s9.4 21 21 21c10.5 0 20-7.8 20-21 0-1.4-.2-2.7-.5-4z"/><path fill="#34A853" d="M6.3 14.7l7 5.1C15 16.1 19.2 13 24 13c3.1 0 5.9 1.1 8.1 2.9l6.4-6.4C34.6 5.1 29.6 3 24 3c-7.7 0-14.3 4.4-17.7 11.7z"/><path fill="#FBBC05" d="M24 45c5.5 0 10.5-1.9 14.4-5.1l-6.7-5.5C29.6 36 26.9 37 24 37c-6 0-11.1-4-12.9-9.5l-7 5.4C7.6 40.5 15.2 45 24 45z"/><path fill="#EA4335" d="M44.5 20H24v8.5h11.8c-1 3-3.3 5.4-6.3 7l6.7 5.5C40.3 37.6 45 31.5 45 24c0-1.4-.2-2.7-.5-4z"/></svg>
              <div>
                <div class="hero-rating-stars" aria-label="5 out of 5 stars">★★★★★</div>
                <div class="hero-rating-label">Rated 5 Stars on Google</div>
              </div>
            </div>
          </div>
          <ul class="hero-checklist list-none p-0 mt-4 flex flex-row flex-wrap gap-4">
            <li class="flex items-start gap-2 text-[0.97rem] text-white/90">24/7 Dispatch</li>
            <li class="flex items-start gap-2 text-[0.97rem] text-white/90">Full-Service Recovery</li>
            <li class="flex items-start gap-2 text-[0.97rem] text-white/90">Residential + Commercial</li>
          </ul>
        </div>
        <div class="hero-carousel-controls" aria-label="Choose background image">
          <button class="hero-dot is-active" type="button" aria-label="Show water damage response" aria-current="true"></button>
          <button class="hero-dot" type="button" aria-label="Show fire damage recovery"></button>
          <button class="hero-dot" type="button" aria-label="Show storm damage response"></button>
        </div>
      </section>

      <!-- Service strip -->
      <div class="grid grid-cols-5 gap-1.5 px-1.5 py-1.5 max-sm:grid-cols-2">
        <a class="service-strip-card relative flex flex-col items-center justify-center gap-[14px] overflow-hidden no-underline h-[200px] max-sm:h-[140px]"
          href="/actionrestoration/water-damage" style="--strip-img: url('/sites/actionrestoration/assets/service-water-damage.webp'); background-image: linear-gradient(to bottom,rgba(6,18,36,0.55),rgba(6,18,36,0.55)), var(--strip-img); background-size:cover; background-position:center;">
          <svg class="w-12 h-12 flex-shrink-0 relative z-10" viewBox="0 0 64 64" fill="none"><path d="M32 8C32 8 14 26 14 38a18 18 0 0 0 36 0C50 26 32 8 32 8Z" stroke="white" stroke-width="2.5" stroke-linejoin="round"/><path d="M22 42c2 4 6 6 10 6" stroke="white" stroke-width="2.5" stroke-linecap="round"/></svg>
          <span class="font-sora text-[0.82rem] font-bold tracking-[0.1em] uppercase text-white text-center relative z-10">Water Damage</span>
        </a>
        <a class="service-strip-card relative flex flex-col items-center justify-center gap-[14px] overflow-hidden no-underline h-[200px] max-sm:h-[140px]"
          href="/actionrestoration/fire-damage" style="--strip-img: url('/sites/actionrestoration/assets/service-fire-damage.webp'); background-image: linear-gradient(to bottom,rgba(6,18,36,0.55),rgba(6,18,36,0.55)), var(--strip-img); background-size:cover; background-position:center;">
          <svg class="w-12 h-12 flex-shrink-0 relative z-10" viewBox="0 0 64 64" fill="none"><path d="M32 8c0 0-4 8-2 14-6-4-8-12-8-12C16 18 12 26 12 34a20 20 0 0 0 40 0c0-12-8-18-8-18-2 6-6 10-12 12 4-8 0-20 0-20Z" stroke="white" stroke-width="2.5" stroke-linejoin="round"/></svg>
          <span class="font-sora text-[0.82rem] font-bold tracking-[0.1em] uppercase text-white text-center relative z-10">Fire Damage</span>
        </a>
        <a class="service-strip-card relative flex flex-col items-center justify-center gap-[14px] overflow-hidden no-underline h-[200px] max-sm:h-[140px]"
          href="#" style="--strip-img: url('/sites/actionrestoration/assets/service-storm-damage.webp'); background-image: linear-gradient(to bottom,rgba(6,18,36,0.55),rgba(6,18,36,0.55)), var(--strip-img); background-size:cover; background-position:center;">
          <svg class="w-12 h-12 flex-shrink-0 relative z-10" viewBox="0 0 64 64" fill="none"><path d="M12 52 L52 12M20 20 Q32 8 44 20 Q56 32 44 44 Q32 56 20 44 Q8 32 20 20Z" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="font-sora text-[0.82rem] font-bold tracking-[0.1em] uppercase text-white text-center relative z-10">Storm Damage</span>
        </a>
        <a class="service-strip-card relative flex flex-col items-center justify-center gap-[14px] overflow-hidden no-underline h-[200px] max-sm:h-[140px]"
          href="#" style="--strip-img: url('/sites/actionrestoration/assets/service-leak-detection.webp'); background-image: linear-gradient(to bottom,rgba(6,18,36,0.55),rgba(6,18,36,0.55)), var(--strip-img); background-size:cover; background-position:center;">
          <svg class="w-12 h-12 flex-shrink-0 relative z-10" viewBox="0 0 64 64" fill="none"><circle cx="32" cy="32" r="10" stroke="white" stroke-width="2.5"/><path d="M32 14v4M32 46v4M14 32h4M46 32h4M19.5 19.5l2.8 2.8M41.7 41.7l2.8 2.8M19.5 44.5l2.8-2.8M41.7 22.3l2.8-2.8" stroke="white" stroke-width="2.5" stroke-linecap="round"/></svg>
          <span class="font-sora text-[0.82rem] font-bold tracking-[0.1em] uppercase text-white text-center relative z-10">Leak Detection</span>
        </a>
        <a class="service-strip-card relative flex flex-col items-center justify-center gap-[14px] overflow-hidden no-underline h-[200px] max-sm:h-[140px]"
          href="/actionrestoration/mold-remediation" style="--strip-img: url('/sites/actionrestoration/assets/service-mold-remediation.webp'); background-image: linear-gradient(to bottom,rgba(6,18,36,0.55),rgba(6,18,36,0.55)), var(--strip-img); background-size:cover; background-position:center;">
          <svg class="w-12 h-12 flex-shrink-0 relative z-10" viewBox="0 0 64 64" fill="none"><circle cx="24" cy="36" r="8" stroke="white" stroke-width="2.5"/><circle cx="38" cy="28" r="6" stroke="white" stroke-width="2.5"/><circle cx="46" cy="40" r="5" stroke="white" stroke-width="2.5"/><path d="M16 44 Q32 52 52 44" stroke="white" stroke-width="2.5" stroke-linecap="round"/></svg>
          <span class="font-sora text-[0.82rem] font-bold tracking-[0.1em] uppercase text-white text-center relative z-10">Mold Remediation</span>
        </a>
      </div>

      <!-- About + Why Choose wrapper -->
      <div class="max-w-site mx-auto px-5" style="position:relative;">
        <!-- About split -->
        <section class="grid grid-cols-2 gap-[60px] items-start py-[80px] max-sm:grid-cols-1 max-sm:py-[48px] max-sm:gap-[32px]" style="position:relative;z-index:1;">
          <div class="flex flex-col gap-5 max-sm:px-0">
            <span class="inline-flex mb-[9px] items-center gap-2 text-[0.75rem] font-sora uppercase tracking-[0.08em] font-bold text-water-blue"><img src="/sites/actionrestoration/assets/water-and-fire.png" alt="" aria-hidden="true" class="w-5 h-5 object-contain" />About Us</span>
            <h2 class="font-sora text-[clamp(2rem,3.2vw,3rem)] font-extrabold leading-[1.08] text-navy-950">Welcome to <br>Reactive Restoration Services</h2>
            <p class="text-[1.05rem] font-semibold text-navy-950">We are a qualified full-service restoration company specializing in emergency property damage recovery across Howell, NJ and surrounding Monmouth County communities.</p>
            <p class="text-slate-ar-700 text-[1rem] leading-[1.7]">Water migration, fire, smoke, and mold conditions escalate fast. Our response model prioritizes immediate stabilization first, then structured restoration to return your property to pre-loss condition.</p>
            <p class="text-slate-ar-700 text-[1rem] leading-[1.7]">We serve homeowners, property managers, and commercial facilities with a single-vendor recovery approach — so you don't have to coordinate multiple contractors during an already stressful event.</p>
            <div class="flex flex-col gap-0.5 mt-2">
              <span class="text-[0.78rem] font-semibold text-water-blue uppercase tracking-[0.06em]">Call For More Information</span>
              <a class="font-sora text-[1.7rem] font-bold text-navy-950 transition-colors duration-200 hover:text-orange-500 phone-link-light" href="tel:+17325108149"><svg class="fa-phone-icon" aria-hidden="true" viewBox="0 0 512 512" fill="currentColor"><path d="M164.9 24.6C157.2 6 136.9-3.9 117.5 1.4l-88 24C12.6 30 0 45.4 0 62.9 0 311.9 201.9 512 449.1 512c17.4 0 32.9-12.6 37.5-29.5l24-88c5.3-19.4-4.6-39.7-23.2-47.4l-96-40c-16.3-6.8-35.2-2.1-46.3 11.6l-40.4 49.3c-70.7-33.3-127.4-90-160.7-160.7l49.3-40.4c13.7-11.2 18.4-30 11.6-46.3l-40-96z"/></svg><span>(732) 510-8149</span></a>
            </div>
          </div>
          <div class="sticky-section relative max-sm:order-last overflow-hidden">
            <img class="w-full h-full min-h-[460px] object-cover block max-sm:min-h-[280px]" src="/sites/actionrestoration/assets/hero-water-restoration.webp" alt="Restoration technicians extracting water inside a home" />
          </div>
        </section>

        <!-- Why Choose Us -->
        <section class="why-editorial py-[80px] max-sm:py-[48px]">
          <div class="grid grid-cols-2 gap-[72px] items-center max-lg:grid-cols-1 max-lg:gap-8">
            <div>
              <span class="inline-flex mb-[9px] items-center gap-2 text-[0.75rem] font-sora uppercase tracking-[0.08em] font-bold text-water-blue"><img src="/sites/actionrestoration/assets/water-and-fire.png" alt="" aria-hidden="true" class="w-5 h-5 object-contain" />Why Choose Us</span>
              <h2 class="font-sora text-[clamp(2.2rem,4.5vw,4rem)] font-extrabold leading-[1.04] text-navy-950">Restoration Built Around Fast Action and Clear Recovery.</h2>
            </div>
            <div>
              <p class="text-slate-ar-700 text-[1.04rem] leading-[1.8] mb-5">We do not leave property owners coordinating multiple vendors while damage continues to spread. Our team prioritizes stabilization, explains the scope clearly, and keeps mitigation and restoration moving through one organized process.</p>
              <p class="text-slate-ar-700 text-[1.04rem] leading-[1.8] mb-8">From emergency water extraction and smoke cleanup to mold remediation and reconstruction planning, every phase is built around safe occupancy, dependable communication, and a practical return to pre-loss conditions.</p>
              <div class="why-proof-grid">
                <div><strong>15+</strong><span>Years Experience</span></div>
                <div><strong>500+</strong><span>Properties Restored</span></div>
                <div><strong>100%</strong><span>Licensed &amp; Insured</span></div>
              </div>
            </div>
          </div>
        </section>

      </div>

      <!-- Restoration gallery marquee -->
      <div class="restoration-gallery" aria-label="Restoration services gallery">
        <div class="restoration-gallery-track">
          <figure><img src="/sites/actionrestoration/assets/hero-water-restoration.webp" alt="Water extraction inside a home" /></figure>
          <figure><img src="/sites/actionrestoration/assets/hero-fire-restoration.webp" alt="Fire and smoke restoration crew" /></figure>
          <figure><img src="/sites/actionrestoration/assets/hero-storm-monmouth.webp" alt="Storm response at a Monmouth County home" /></figure>
          <figure><img src="/sites/actionrestoration/assets/service-leak-detection.webp" alt="Thermal leak detection inspection" /></figure>
          <figure><img src="/sites/actionrestoration/assets/service-mold-remediation.webp" alt="Contained mold remediation work" /></figure>
          <figure><img src="/sites/actionrestoration/assets/service-water-damage.webp" alt="Professional water damage extraction" /></figure>
          <figure><img src="/sites/actionrestoration/assets/service-fire-damage.webp" alt="Soot and fire damage cleanup" /></figure>
          <figure><img src="/sites/actionrestoration/assets/service-storm-damage.webp" alt="Storm-damaged roof being secured" /></figure>
          <figure aria-hidden="true"><img src="/sites/actionrestoration/assets/hero-water-restoration.webp" alt="" /></figure>
          <figure aria-hidden="true"><img src="/sites/actionrestoration/assets/hero-fire-restoration.webp" alt="" /></figure>
          <figure aria-hidden="true"><img src="/sites/actionrestoration/assets/hero-storm-monmouth.webp" alt="" /></figure>
          <figure aria-hidden="true"><img src="/sites/actionrestoration/assets/service-leak-detection.webp" alt="" /></figure>
          <figure aria-hidden="true"><img src="/sites/actionrestoration/assets/service-mold-remediation.webp" alt="" /></figure>
          <figure aria-hidden="true"><img src="/sites/actionrestoration/assets/service-water-damage.webp" alt="" /></figure>
          <figure aria-hidden="true"><img src="/sites/actionrestoration/assets/service-fire-damage.webp" alt="" /></figure>
          <figure aria-hidden="true"><img src="/sites/actionrestoration/assets/service-storm-damage.webp" alt="" /></figure>
        </div>
      </div>

      <!-- Reviews band -->
      <section class="reviews-band relative overflow-hidden"
        style="background-image: url('/sites/actionrestoration/assets/hero-fire-restoration.webp'); background-size:cover; background-position:center;">
        <div class="w-full max-w-site mx-auto relative z-10 px-5 py-[80px] max-sm:py-[52px]">

          <!-- Desktop: 2-col grid -->
          <div class="grid grid-cols-2 gap-[60px] items-center max-sm:hidden">
            <div>
              <span class="inline-flex mb-[9px] items-center gap-2 text-[0.75rem] font-sora uppercase tracking-[0.08em] font-bold" style="color:#d2e8ff;"><img src="/sites/actionrestoration/assets/water-and-fire.png" alt="" aria-hidden="true" class="w-5 h-5 object-contain" />Client Reviews</span>
              <h2 class="font-sora text-[clamp(1.8rem,3.5vw,3rem)] font-extrabold text-white leading-[1.08] mb-8 uppercase">What Our Clients Are Saying</h2>
              <div class="flex gap-[14px] flex-wrap">
                <a class="testimonial-google-review" href="https://www.google.com/search?q=Reactive+Restoration+Services+Howell+NJ+reviews" target="_blank" rel="noopener noreferrer"><svg class="google-review-logo" viewBox="0 0 24 24" aria-hidden="true"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg><span>Leave Us a Review</span></a>
                <a class="rounded-full inline-flex items-center justify-center gap-1.5 px-4 py-2.5 font-sora text-[0.84rem] font-bold tracking-[0.01em] cursor-pointer transition-all duration-200 hover:-translate-y-px bg-transparent text-white border border-white/60 hover:bg-white/10 hover:border-white/90" href="#">Read More Reviews</a>
              </div>
            </div>
            <div class="relative mx-6">
              <button class="absolute top-1/2 -translate-y-1/2 -left-[22px] w-11 h-11 rounded-full border border-white/40 bg-navy-700 text-white flex items-center justify-center cursor-pointer transition-colors hover:bg-orange-500 z-[2]" id="reviewsPrev" aria-label="Previous review">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <div class="bg-white/[0.12] backdrop-blur-[10px] border border-white/[0.18] rounded-[14px] px-8 py-7 flex flex-col gap-5" id="reviewsCard">
                <div class="flex justify-between items-start">
                  <span class="text-[3.5rem] leading-none text-white/80 font-[Georgia,serif]">&ldquo;</span>
                  <div class="text-[#f5a623] text-[1.3rem] tracking-[2px]">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                </div>
                <p class="text-white/90 text-[1rem] leading-[1.7] italic m-0" id="reviewsText"></p>
                <div class="flex items-center gap-[14px]">
                  <div class="w-11 h-11 rounded-full bg-orange-500 text-white font-sora font-bold text-[1.1rem] flex items-center justify-center flex-shrink-0" id="reviewsAvatar"></div>
                  <div class="flex-1 min-w-0">
                    <strong class="block text-white text-[1rem] font-bold" id="reviewsName"></strong>
                    <span class="text-white/65 text-[0.85rem]" id="reviewsRole"></span>
                  </div>
                  <svg class="w-6 h-6 flex-shrink-0 ml-auto" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
                </div>
              </div>
              <button class="absolute top-1/2 -translate-y-1/2 -right-[22px] w-11 h-11 rounded-full border border-white/40 bg-navy-700 text-white flex items-center justify-center cursor-pointer transition-colors hover:bg-orange-500 z-[2]" id="reviewsNext" aria-label="Next review">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </div>
          </div>

          <!-- Mobile: stacked — eyebrow, heading, card, buttons -->
          <div class="hidden max-sm:flex flex-col items-center text-center gap-[28px]">
            <div>
              <span class="inline-flex mb-[9px] items-center gap-2 text-[0.75rem] font-sora uppercase tracking-[0.08em] font-bold" style="color:#d2e8ff;"><img src="/sites/actionrestoration/assets/water-and-fire.png" alt="" aria-hidden="true" class="w-5 h-5 object-contain" />Client Reviews</span>
              <h2 class="font-sora text-[clamp(1.8rem,3.5vw,3rem)] font-extrabold text-white leading-[1.08] uppercase">What Our Clients Are Saying</h2>
            </div>
            <!-- Card with side arrows contained inside relative wrapper -->
            <div class="relative w-full">
              <button class="absolute top-1/2 -translate-y-1/2 left-0 w-11 h-11 rounded-full border border-white/40 bg-navy-700 text-white flex items-center justify-center cursor-pointer transition-colors hover:bg-orange-500 z-[2]" id="reviewsPrevMobile" aria-label="Previous review">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <div class="bg-white/[0.12] backdrop-blur-[10px] border border-white/[0.18] rounded-[14px] px-5 py-6 flex flex-col gap-5 text-left mx-[22px]" id="reviewsCardMobile">
                <div class="flex justify-between items-start">
                  <span class="text-[3.5rem] leading-none text-white/80 font-[Georgia,serif]">&ldquo;</span>
