---
---

<section class="w-full py-24 px-6 md:px-16 relative overflow-hidden" style="background: #760202;">


  <div class="max-w-7xl mx-auto relative z-10">

    <!-- Heading -->
    <div class="flex flex-col items-center text-center mb-16">
      <span class="as-label-caps mb-2" style="color: rgba(255,255,255,0.45);">WHY ALERT</span>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-white">
        The Alert Difference
      </h2>
    </div>

    <!-- Layout: stats left | center image | stats right -->
    <div class="flex flex-col lg:flex-row items-center justify-center gap-10 lg:gap-0">

      <!-- Left stats -->
      <div class="flex flex-col gap-12 lg:items-end lg:text-right lg:flex-1 lg:pr-12">
        <div>
          <div class="font-extrabold text-white" style="font-size: clamp(36px, 4vw, 52px); line-height: 1; letter-spacing: -0.02em;">45+</div>
          <div class="as-label-caps text-white mt-1">Years in Business</div>
          <p class="text-sm mt-2 max-w-xs lg:ml-auto" style="color: rgba(255,255,255,0.75);">Established 1977. Trusted across NJ &amp; southeastern PA for over four decades.</p>
        </div>
        <div>
          <div class="font-extrabold text-white" style="font-size: clamp(36px, 4vw, 52px); line-height: 1; letter-spacing: -0.02em;">5-yr</div>
          <div class="as-label-caps text-white mt-1">Union Apprenticeship</div>
          <p class="text-sm mt-2 max-w-xs lg:ml-auto" style="color: rgba(255,255,255,0.75);">Every fitter completes a rigorous 5-year union apprenticeship before stepping on a job site.</p>
        </div>
      </div>

      <!-- Center image -->
      <div class="shrink-0 relative" style="width: clamp(220px, 28vw, 340px); height: clamp(220px, 28vw, 340px);">
        <!-- Diamond frame -->
        <div class="absolute pointer-events-none" style="width: 210%; height: 210%; top: 50%; left: 50%; transform: translate(-50%, -50%) rotate(45deg); border: 2px solid rgba(255,255,255,0.2);"></div>
        <div class="absolute pointer-events-none" style="width: 193%; height: 193%; top: 50%; left: 50%; transform: translate(-50%, -50%) rotate(45deg); border: 1px solid rgba(255,255,255,0.1);"></div>
        <!-- Thick white ring frame -->
        <div class="absolute inset-0 rounded-full" style="border: 14px solid #fff; box-shadow: 0 0 0 3px rgba(255,255,255,0.2);"></div>
        <!-- Image -->
        <div class="absolute rounded-full overflow-hidden" style="inset: 14px;">
          <img
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuAaBsZ8KP8agvAtmGrY0n20wVEZ77rC_1jL6iY3FgIesxT97sirkIgflr420yT8DWbSIadTcUniCqhyu0YUq8RlgFfKLP3DBlR5iDQUvGgiMoyQ5Oe1LXJtEmNF5duKhN2Wdd48EU8UMPGewrwtMsbOeeo4MgpO-kxYNY_M3WR_sSEFfVaBJhxJG6D9nyVsD3c5_nSzwmABwLccO05NvPOs0ibqmy3zkIXMgX1hHEaHe5se87BglB4-8D7C1i4EwyR2GUSPGgoTNpM"
            alt="Alert Sprinkler crew at work"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <!-- Learn more link below circle -->
        <a
          href="/alert-sprinkler/about"
          class="absolute -bottom-10 left-1/2 -translate-x-1/2 whitespace-nowrap text-sm font-bold text-white/70 hover:text-white transition-colors flex items-center gap-1"
        >
          Learn More <span style="font-size: 1rem;">›</span>
        </a>
      </div>

      <!-- Right stats -->
      <div class="flex flex-col gap-12 lg:items-start lg:text-left lg:flex-1 lg:pl-12">
        <div>
          <div class="font-extrabold text-white" style="font-size: clamp(36px, 4vw, 52px); line-height: 1; letter-spacing: -0.02em;">25+</div>
          <div class="as-label-caps text-white mt-1">Years, Same Core Crew</div>
          <p class="text-sm mt-2 max-w-xs" style="color: rgba(255,255,255,0.75);">We've built and kept the same team of skilled fitters for over 25 years — experience you can count on.</p>
        </div>
        <div>
          <div class="font-extrabold text-white" style="font-size: clamp(36px, 4vw, 52px); line-height: 1; letter-spacing: -0.02em;">24/7</div>
          <div class="as-label-caps text-white mt-1">Emergency Response</div>
          <p class="text-sm mt-2 max-w-xs" style="color: rgba(255,255,255,0.75);">A leak or failure can't wait. Our rapid-response teams are on standby every hour of every day.</p>
        </div>
      </div>

    </div>

  </div>
</section>
