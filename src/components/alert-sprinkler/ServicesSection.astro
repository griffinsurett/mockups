---
const services = [
  {
    number: "01",
    title: "Design & Engineering",
    description: "Code-compliant fire sprinkler solutions tailored to your facility's layout, occupancy, and hazard classification.",
    img: "/alert-sprinkler/steps/blueprints.png",
    href: "/alert-sprinkler/contact",
  },
  {
    number: "02",
    title: "Installation",
    description: "Union-trained fitters with decades of field experience — from new construction to full retrofits.",
    img: "/alert-sprinkler/steps/installation.png",
    href: "/alert-sprinkler/contact",
  },
  {
    number: "03",
    title: "Inspection & Testing",
    description: "Comprehensive NFPA 25 inspection and testing programs to keep you compliant and audit-ready.",
    img: "/alert-sprinkler/steps/testing.png",
    href: "/alert-sprinkler/contact",
  },
  {
    number: "04",
    title: "Maintenance",
    description: "Scheduled maintenance programs that prevent failures before they happen.",
    img: "/alert-sprinkler/steps/maintenance.png",
    href: "/alert-sprinkler/contact",
  },
  {
    number: "05",
    title: "Repair",
    description: "Fast deficiency corrections and component repair to restore full protection quickly.",
    img: "/alert-sprinkler/steps/repair.png",
    href: "/alert-sprinkler/contact",
  },
  {
    number: "06",
    title: "Emergency Service",
    description: "24/7 rapid-response teams on standby every hour of every day.",
    img: "/alert-sprinkler/steps/emergancy.png",
    href: "/alert-sprinkler/contact",
  },
];
---

<section id="services" class="w-full py-24 px-6 md:px-16" style="background: #F8FAFC;">
  <div class="max-w-7xl mx-auto">

    <!-- Header -->
    <div class="flex flex-col items-center text-center mb-16">
      <span class="as-label-caps text-as-primary mb-2">WHAT WE DO</span>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight" style="color: #291715;">Our Services</h2>
      <p class="mt-4 text-base max-w-2xl" style="color: #5d3f3b;">
        From initial design through emergency response — we cover the full lifecycle of fire sprinkler protection.
      </p>
    </div>

    <!-- 6-card image grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {services.map((s) => (
        <a href={s.href} class="group relative overflow-hidden block" style="border-radius: 0.5rem; aspect-ratio: 4/3;">
          <!-- Background image -->
          <img
            src={s.img}
            alt={s.title}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
          <!-- Dark gradient overlay -->
          <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(20,5,5,0.85) 0%, rgba(20,5,5,0.3) 55%, transparent 100%);"></div>
          <!-- Arrow icon top-right -->
          <div class="absolute top-4 right-4 w-8 h-8 flex items-center justify-center rounded-full bg-white/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 12L12 2M12 2H5M12 2V9" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <!-- Text overlay -->
          <div class="absolute bottom-0 left-0 right-0 p-6">
            <span class="as-label-caps text-white/60 mb-1 block">{s.number}</span>
            <h3 class="text-xl font-extrabold text-white tracking-tight mb-2">{s.title}</h3>
            <p class="text-sm text-white/75 leading-relaxed">{s.description}</p>
          </div>
        </a>
      ))}
    </div>

    <!-- Sectors note -->
    <p class="mt-10 text-sm text-center max-w-2xl mx-auto" style="color: #5d3f3b;">
      Serving <span style="color: #291715; font-weight: 600;">Commercial, Industrial, Institutional,</span> and <span style="color: #291715; font-weight: 600;">Residential</span> facilities across New Jersey and southeastern Pennsylvania.
    </p>

  </div>
</section>
