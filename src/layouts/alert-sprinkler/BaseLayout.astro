---
import "../../styles/global.css";
import "../../styles/alert-sprinkler.css";

interface Props {
  title?: string;
}
const { title = "Alert Sprinkler Co., Inc." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;700;800&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="overflow-x-hidden" style="font-family: 'Hanken Grotesk', sans-serif; background: #fff8f7; color: #291715;">

    <!-- ============ HEADER ============ -->

    <!-- Emergency top bar: visible at top, slides away on scroll -->
    <div id="as-topbar" class="fixed inset-x-0 top-0 z-60 flex flex-col md:flex-row items-center justify-center gap-0.5 md:gap-3 px-4 py-1.5 md:py-2 transition-transform duration-300" style="background: #760202;">
      <span class="as-label-caps text-white/80">Fire sprinkler emergency? We respond 24/7 —</span>
      <a href="tel:7325211666" class="as-label-caps text-white font-extrabold hover:text-white/80 transition-colors">Call 732-521-1666</a>
    </div>

    <!-- Top bar + header wrapper: stacked flush -->
    <div id="as-header-wrap" class="fixed inset-x-0 z-50 flex flex-col transition-all duration-300">


    <header id="as-header" data-as-header class="w-full">


      <!-- Desktop layout -->
      <div class="hidden md:flex items-center justify-between w-[95%] mx-auto relative overflow-visible z-10" data-as-inner>

        <!-- Left: Nav -->
        <nav class="flex gap-8 items-center flex-1" data-as-nav>
          <a href="/alert-sprinkler" class="as-nav-link active">Home</a>
          <a href="/alert-sprinkler#services" class="as-nav-link">Services</a>
          <a href="/alert-sprinkler#about" class="as-nav-link">About</a>
          <a href="/alert-sprinkler/contact" class="as-nav-link">Contact</a>
        </nav>

        <!-- Logo: in flow, small, always visible -->
        <a href="/alert-sprinkler" class="as-logo-inline" aria-hidden="false">
          <img
            src="/alert-sprinkler/alert-logo.png"
            alt="Alert Sprinkler Co., Inc."
            class="as-logo-img-small object-contain"
          />
        </a>

        <!-- Right: Phone + CTA -->
        <div class="flex items-center gap-5 flex-1 justify-end">
          <div class="flex flex-col items-end leading-tight">
            <span class="as-label-caps as-phone-label">CALL US</span>
            <a href="tel:7325211666" class="as-phone-num font-extrabold text-[18px] tracking-tight">732-521-1666</a>
          </div>
          <a href="/alert-sprinkler/contact" class="as-btn-primary whitespace-nowrap">
            Request A Call Back
          </a>
        </div>

      </div>

      <!-- Mobile layout -->
      <div class="flex md:hidden items-center justify-between w-full px-5 h-16 relative" data-as-inner>

        <!-- Hamburger -->
        <button class="flex flex-col gap-1.5 p-2 shrink-0" aria-label="Open menu" id="as-mobile-menu-btn">
          <span class="as-hamburger-bar block w-6 rounded" style="height:2px;"></span>
          <span class="as-hamburger-bar block w-6 rounded" style="height:2px;"></span>
          <span class="as-hamburger-bar block w-6 rounded" style="height:2px;"></span>
        </button>

        <!-- Logo centered: hidden at top, fades in on scroll -->
        <a href="/alert-sprinkler" class="as-logo-mobile" style="position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); display: flex; align-items: center;">
          <img
            src="/alert-sprinkler/alert-logo.png"
            alt="Alert Sprinkler Co., Inc."
            class="as-logo-img object-contain"
            loading="eager"
          />
        </a>

        <!-- Phone icon -->
        <a href="tel:7325211666" class="shrink-0 p-2 as-phone-icon" aria-label="Call us">
          <span class="material-symbols-outlined" style="font-size: 1.5rem; font-variation-settings: 'FILL' 1;">call</span>
        </a>

      </div>

    </header>
    </div><!-- end header wrap -->

    <slot />

  </body>

  <style>
    /* ── Header bg: transparent at top, solid white on scroll ── */
    [data-as-header] {
      transition: background 300ms ease, box-shadow 300ms ease;
    }
    [data-as-header][data-scrolled="true"] {
      background: rgba(255, 248, 247, 0.97);
      box-shadow: 0 1px 16px rgba(41,23,21,0.1);
      backdrop-filter: blur(10px);
    }

    /* ── Inner row: always 5rem ── */
    [data-as-header] [data-as-inner] {
      height: 5rem;
      padding: 0;
    }

    /* ── Logo: hidden at top, fades in on scroll ── */
    [data-as-header] .as-logo-inline {
      opacity: 0;
      pointer-events: none;
      transition: opacity 320ms ease;
      display: flex;
      align-items: center;
      align-self: stretch;
      margin: 0 auto;
    }
    [data-as-header][data-scrolled="true"] .as-logo-inline {
      opacity: 1;
      pointer-events: auto;
    }
    [data-as-header] .as-logo-img-small {
      display: block;
      height: 100%;
      width: auto;
    }

    /* ── Nav: vertically centred in the bar ── */
    [data-as-header] [data-as-nav] {
      align-self: center;
    }

    /* ── Nav link colors ── */
    [data-as-header] .as-nav-link {
      color: rgba(255,255,255,0.85);
    }
    [data-as-header] .as-nav-link:hover,
    [data-as-header] .as-nav-link.active {
      color: #fff;
    }
    [data-as-header][data-scrolled="true"] .as-nav-link {
      color: #5d3f3b;
    }
    [data-as-header][data-scrolled="true"] .as-nav-link:hover,
    [data-as-header][data-scrolled="true"] .as-nav-link.active {
      color: #760202;
    }
    [data-as-header] .as-nav-link.active {
      border-bottom: 2px solid currentColor;
      padding-bottom: 2px;
    }

    /* ── Phone ── */
    [data-as-header] .as-phone-label { color: rgba(255,255,255,0.65); }
    [data-as-header] .as-phone-num   { color: #fff; }
    [data-as-header][data-scrolled="true"] .as-phone-label { color: #5d3f3b; }
    [data-as-header][data-scrolled="true"] .as-phone-num   { color: #760202; }

    /* ── Hamburger bars ── */
    [data-as-header] .as-hamburger-bar { background: rgba(255,255,255,0.9); }
    [data-as-header][data-scrolled="true"] .as-hamburger-bar { background: #291715; }

    /* ── Mobile phone icon ── */
    [data-as-header] .as-phone-icon { color: rgba(255,255,255,0.9); }
    [data-as-header][data-scrolled="true"] .as-phone-icon { color: #760202; }

    /* ── Mobile header logo: hidden at top, fades in on scroll ── */
    [data-as-header] .as-logo-mobile {
      opacity: 0;
      pointer-events: none;
      transition: opacity 320ms ease;
    }
    [data-as-header][data-scrolled="true"] .as-logo-mobile {
      opacity: 1;
      pointer-events: auto;
    }

    /* ── Mobile ── */
    @media (max-width: 767px) {
      [data-as-header] .as-logo-mobile {
        height: 100%;
        align-self: stretch;
        display: flex;
        align-items: center;
      }
      [data-as-header] .as-logo-img {
        height: 100%;
        width: auto;
      }
      [data-as-header][data-scrolled="true"] {
        background: rgba(255, 248, 247, 0.97);
        box-shadow: 0 1px 16px rgba(41,23,21,0.1);
      }
      [data-as-backdrop] { display: none; }
    }

    @media (prefers-reduced-motion: reduce) {
      [data-as-header] *,
      [data-as-header] *::before,
      [data-as-header] *::after {
        transition: none !important;
      }
    }

    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }
  </style>

  <script>
    (function initAsHeader() {
      if (typeof window === "undefined") return;

      const topbar     = document.getElementById("as-topbar");
      const headerWrap = document.getElementById("as-header-wrap");
      const header     = document.getElementById("as-header");
      if (!header) return;

      const getTopbarH = () => topbar ? topbar.offsetHeight : 0;

      const backdrop = header.querySelector("[data-as-backdrop]") as HTMLElement | null;
      const inner    = header.querySelector("[data-as-inner]")    as HTMLElement | null;

      const setBackdropHeight = () => {
        if (backdrop && inner) {
          backdrop.style.height = `${inner.offsetHeight}px`;
        }
      };

      let ticking = false;
      let bgLocked = false;

      const update = () => {
        const y = window.scrollY;

        // Slide topbar out on scroll, back in at top
        if (topbar && headerWrap) {
          if (y > 10) {
            topbar.style.transform = "translateY(-100%)";
            headerWrap.style.top = "0px";
          } else {
            topbar.style.transform = "translateY(0)";
            headerWrap.style.top = `${getTopbarH()}px`;
          }
        }

        // Logo compact
        if (y > 44) {
          header.setAttribute("data-compact", "true");
          bgLocked = true;
        } else {
          header.removeAttribute("data-compact");
        }

        // Backdrop/bg
        if (bgLocked) {
          header.setAttribute("data-scrolled", "true");
          if (y < 280) {
            bgLocked = false;
            header.removeAttribute("data-scrolled");
          }
        }

        setBackdropHeight();
        ticking = false;
      };

      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      };

      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", () => { setBackdropHeight(); requestAnimationFrame(update); }, { passive: true });
      requestAnimationFrame(update);
      setBackdropHeight();
    })();
  </script>

</html>
